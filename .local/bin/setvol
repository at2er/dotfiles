#!/bin/sh

SHIFT=5

[ -n "$2" ] && SHIFT=$2

usage() {
	cat << EOF
usage: volume [-dhmu] [VOLUME]
  -d: down
  -h: usage
  -m: toggle mute
  -u: up
EOF
}

case "$1" in
	"-d") wpctl set-volume @DEFAULT_SINK@ ${SHIFT}%- ;;
	"-h") usage ;;
	"-m") wpctl set-mute @DEFAULT_SINK@ toggle ;;
	"-u") wpctl set-volume @DEFAULT_SINK@ ${SHIFT}%+ ;;
esac
